# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Vercel: Environment Variables (не NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin (auth redirects, YooKassa return_url fallback)
# Local:     http://localhost:3000
# Production: https://your-project.vercel.app (или custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YooKassa — server-only
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional; default: {NEXT_PUBLIC_SITE_URL}/checkout/success
# Production example: https://your-project.vercel.app/checkout/success
YOOKASSA_RETURN_URL=
