# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — Vercel: Environment Variables (не NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin (auth redirects, YooKassa return_url fallback)
# Local:     http://localhost:3000
# Production: https://designtusovka.ru (можно без https:// — добавится автоматически)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YooKassa — server-only
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional; default: {NEXT_PUBLIC_SITE_URL}/checkout/success
# Production example: https://designtusovka.ru/checkout/success
YOOKASSA_RETURN_URL=
# Optional; "true"/"1"/"yes" — включить фискальный чек (54-ФЗ) в платеже.
# Требует настроенной фискализации магазина в ЮKassa. По умолчанию выключено.
YOOKASSA_SEND_RECEIPT=
# Optional; код НДС для позиций чека (1..6). По умолчанию 1 — «Без НДС» (НПД).
YOOKASSA_VAT_CODE=

# Yandex Metrika — only loads when enabled AND user accepted analytics cookies
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_YANDEX_METRIKA_ID=96622077
